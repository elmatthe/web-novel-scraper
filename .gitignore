# ── Python runtime / build artifacts ─────────────────────────────────────────
.venv/
.python_runtime/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.spec
.pytest_cache/

# ── Agent / IDE tooling scratch (not part of the user's locked root layout) ───
.agents/
.claude/
.codex/

# ── Per-machine workspace config: gitignored ON PURPOSE (see AI-WORKSPACE.md's own
#    "Dependency and Environment Rules" section) ──────────────────────────────
AI-WORKSPACE.md

# ── Environment ──────────────────────────────────────────────────────────────
.env

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── OS cruft ─────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db

# Effective generated/dev-only folder ignores. Keep comments on separate lines:
# Git treats inline comments after patterns as literal path text.
files/bin/
files/legacy-reference/
files/test-logs/
files/cache/
files/output/
files/test-output/
files/run-temp/
files/temp/
# GUI preferences and other per-machine runtime state (v0.3.0, plan section 8 C6).
files/runtime-data/
files/**/cache/

# Historical audit/repair evidence is local data, not application source.
# Keep reusable development scripts and tracked fixtures eligible for versioning.
files/dev-work/*-audit-*.json
files/dev-work/final-live-triage-*/

# Output PDFs are generated artifacts — do NOT ignore committed test fixtures.
*.pdf

# ── Keep: committed test inputs live under files/test-files/ and ship to the
#    dev test suite — they must NOT be ignored (re-include any *.pdf fixtures).
!files/test-files/
!files/test-files/**
